---
import { languagesList, getI18n } from '../../i18n/ui';

/* 静态预渲染：枚举全部语言，构建期生成 /en/、/th/、/zh/ 三个静态页。
   天气在构建期抓取一次快照并固化进 HTML（Open-Meteo 在构建环境可访问）。 */
export const getStaticPaths = () =>
  (languagesList as readonly string[]).map((lang) => ({ params: { lang } }));

const langParam = Astro.params.lang ?? '';
if (!(languagesList as readonly string[]).includes(langParam)) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'x-robots-tag': 'noindex' },
  });
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Intro from '../../components/Intro.astro';
import Visit from '../../components/Visit.astro';
import Transport from '../../components/Transport.astro';
import Tips from '../../components/Tips.astro';
import BestTime from '../../components/BestTime.astro';
import Weather from '../../components/Weather.astro';
import Seasons from '../../components/Seasons.astro';
import Facilities from '../../components/Facilities.astro';
import Itinerary from '../../components/Itinerary.astro';
import Plans from '../../components/Plans.astro';
import History from '../../components/History.astro';
import Events from '../../components/Events.astro';
import Gallery from '../../components/Gallery.astro';
import Support from '../../components/Support.astro';
import Credits from '../../components/Credits.astro';
import Nearby from '../../components/Nearby.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import Responsible from '../../components/Responsible.astro';
import Sources from '../../components/Sources.astro';

const { messages } = getI18n(Astro.url);
---

<BaseLayout title={messages.meta.title} description={messages.meta.description}>
  <Hero />
  <Breadcrumbs />
  <Intro />
  <Visit />
  <Transport />
  <BestTime />
  <Weather />
  <Seasons />
  <Facilities />
  <Itinerary />
  <Plans />
  <Tips />
  <Nearby />
  <History />
  <Events />
  <Gallery />
  <Reviews />
  <FAQ />
  <TopicLinks />
  <Responsible />
  <Support />
  <Credits />
  <Sources />
</BaseLayout>
