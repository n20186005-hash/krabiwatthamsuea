---
import { languagesList, getI18n } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Credits from '../../../components/Credits.astro';

export const getStaticPaths = () => (languagesList as readonly string[]).map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang ?? 'en';
const { messages } = getI18n(Astro.url);
---
<BaseLayout title={`${messages.credits.title} | Wat Tham Suea`} description={messages.credits.subtitle} path="photo-credits" breadcrumbTail={{ name: messages.credits.title }}>
  <div class="container" style="padding-top:30px"><a href={`/${lang}/`}>← {messages.footer.siteName}</a></div>
  <Credits />
</BaseLayout>
