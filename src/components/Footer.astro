---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { legal } from '../i18n/legal';

const lang = getLangFromUrl(Astro.url);
const { messages } = getI18n(Astro.url);
const policy = legal[lang] ?? legal.en;
const copy = {
  zh: {
    rights: '版權所有。',
    independence: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
    sources: '资料来源',
  },
  en: {
    rights: 'All rights reserved.',
    independence: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
    sources: 'Sources',
  },
  th: {
    rights: 'สงวนลิขสิทธิ์',
    independence: 'เว็บไซต์นี้เป็นโครงการข้อมูลการท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐหรือองค์กรทางการใด ๆ',
    sources: 'แหล่งข้อมูล',
  },
}[lang] ?? {
  rights: 'All rights reserved.',
  independence: 'Independent travel information project.',
  sources: 'Sources',
};

const footerLinks = [
  { href: `/${lang}/sources-and-updates/`, label: copy.sources },
  { href: `/${lang}/privacy-policy/`, label: policy.privacyTitle },
  { href: `/${lang}/terms-of-service/`, label: policy.termsTitle },
  { href: `/${lang}/cookie-settings/`, label: policy.cookieTitle },
];
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-identity">
      <p class="footer-rights">© 2026 {messages.footer.siteName} · {copy.rights}</p>
      <p class="footer-independence">{copy.independence}</p>
    </div>
    <nav class="footer-links" aria-label={copy.sources}>
      {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-2); border-top: 1px solid var(--border); margin-top: 40px; }
  .footer-content { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px 40px; padding-block: 30px; }
  .footer-identity { max-width: 650px; }
  .footer-identity p { margin: 0; }
  .footer-rights { color: var(--heading); font-weight: 700; }
  .footer-independence { color: var(--text-muted); margin-top: 10px !important; font-size: 0.9rem; line-height: 1.7; }
  .footer-links { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 12px 20px; max-width: 450px; }
  .footer-links a { color: var(--text); font-size: 0.91rem; font-weight: 600; white-space: nowrap; }
  .footer-links a:hover { color: var(--accent-strong); }
  @media (max-width: 760px) { .footer-content { flex-direction: column; } .footer-links { justify-content: flex-start; } }
</style>
