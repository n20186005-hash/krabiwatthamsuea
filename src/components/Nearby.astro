---
import { getI18n } from '../i18n/ui';
import { extendedGuides } from '../i18n/extended-guides';
import { localizedExtendedGuides } from '../i18n/extended-locales';

const { messages } = getI18n(Astro.url);
const n = messages.nearby;

/* 周边语义集群：把周边地标写入实体语义网络 */
const clusterText = n.cluster ?? '';
const { lang } = getI18n(Astro.url);
const tripSlugs = ['krabi-town-nearby', 'emerald-pool-combination', 'hot-springs-combination', 'one-day-krabi-itinerary', 'from-ao-nang', 'from-railay'];
const trips = tripSlugs.map((slug) => lang === 'en' ? extendedGuides[slug] : localizedExtendedGuides[lang as 'zh' | 'th']?.[slug]).filter(Boolean);
const tripLabels = lang === 'zh'
  ? { title: '周边游览与一日路线', intro: '从虎穴寺顺路探索甲米镇，或单独规划翡翠池、温泉等内陆行程；每篇攻略均附有路线、游览重点和目的地地图。', action: '查看路线攻略 →' }
  : lang === 'th'
  ? { title: 'เส้นทางเที่ยวใกล้เคียงและทริปหนึ่งวัน', intro: 'เที่ยวต่อไปตัวเมืองกระบี่ หรือวางแผนทริปแยกไปสระมรกตและน้ำพุร้อน โดยแต่ละคู่มือมีเส้นทางและพิกัดเฉพาะ', action: 'อ่านคู่มือเส้นทาง →' }
  : { title: 'Explore nearby routes & day trips', intro: 'Continue from the temple to Krabi Town, or plan a separate inland journey to the Emerald Pool and hot springs. Each guide explains route order, timings and the relevant map destination.', action: 'Read route guide →' };
---

<section class="section-padding" id="nearby" style="background:var(--surface-accent)">
  <div class="container">
    <span class="eyebrow">{n.eyebrow}</span>
    <h2 class="section-title">{n.title}</h2>
    <p class="cluster-note">{clusterText}</p>
    <p class="section-lead">{n.subtitle}</p>

    <div class="nearby-grid">
      {n.places.map((p: any) => (
        <div class="card card-pad place fade-up">
          <div class="place-head">
            <h3 class="place-name">{p.name}</h3>
            <span class="place-dist">{p.distance}</span>
          </div>
          <p class="place-text">{p.text}</p>
        </div>
      ))}
    </div>
    {(
      <div class="nearby-guides">
        <h3>{tripLabels.title}</h3>
        <p>{tripLabels.intro}</p>
        <div class="nearby-guide-grid">
          {trips.map((trip) => (
            <a href={`/${lang}/${trip.slug}/`} class="nearby-guide-link">
              <strong>{trip.cardLabel}</strong><span>{trip.cardDesc}</span><span class="guide-arrow">{tripLabels.action}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .nearby-guides { margin-top: 2.5rem; }
  .nearby-guides h3 { font-family: var(--font-display); font-size: 1.45rem; color: var(--heading); }
  .nearby-guides > p { max-width: 74ch; line-height: 1.7; color: var(--text-muted); }
  .nearby-guide-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(225px, 1fr)); gap: 1rem; margin-top: 1.15rem; }
  .nearby-guide-link { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 1rem; text-decoration: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .nearby-guide-link:hover { border-color: var(--accent); }
  .nearby-guide-link strong { color: var(--heading); }
  .nearby-guide-link span { color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; }
  .nearby-guide-link .guide-arrow { color: var(--accent-strong); font-weight: 700; margin-top: auto; }
  .nearby-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; margin-top: 30px; }
  .cluster-note {
    margin: 0 0 12px;
    padding: 12px 18px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    color: var(--heading);
    font-size: 1rem;
    max-width: 860px;
  }
  .place-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .place-name { font-size: 1.18rem; margin: 0; }
  .place-dist { font-family: var(--font-body); font-size: 0.82rem; font-weight: 700; color: var(--accent-strong); background: var(--accent-soft); padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
  .place-text { margin: 0; color: var(--text-muted); font-size: 0.95rem; }
</style>
