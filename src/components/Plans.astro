---
import { getI18n } from '../i18n/ui';
import { icon } from '../lib/icons';

const { messages } = getI18n(Astro.url);
const p = messages.plans;
---

<section class="section-padding" id="plans">
  <div class="container">
    <span class="eyebrow">{p.eyebrow}</span>
    <h2 class="section-title">{p.title}</h2>
    <p class="section-lead">{p.subtitle}</p>

    <div class="plans-grid">
      {p.items.map((it: any) => (
        <article class="plan-card card fade-up">
          <div class="plan-head">
            <span class="plan-ico" set:html={icon(it.icon)} />
            <h3>{it.name}</h3>
          </div>
          <p class="plan-audience">{it.audience}</p>

          <dl class="plan-meta">
            <div>
              <dt>{p.durationLabel}</dt>
              <dd>{it.duration}</dd>
            </div>
            <div>
              <dt>{p.difficultyLabel}</dt>
              <dd>{it.difficulty}</dd>
            </div>
          </dl>

          <div class="plan-block">
            <h4>{p.routeLabel}</h4>
            <p>{it.route}</p>
          </div>

          <div class="plan-block">
            <h4>{p.highlightsLabel}</h4>
            <ul class="plan-list good">
              {it.highlights.map((h: string) => (
                <li>
                  <span class="pl-ico" set:html={icon('check')} />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="plan-block">
            <h4>{p.cautionsLabel}</h4>
            <ul class="plan-list warn">
              {it.cautions.map((c: string) => (
                <li>
                  <span class="pl-ico" set:html={icon('warning')} />
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }
  .plan-card { padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .plan-head { display: flex; align-items: center; gap: 12px; }
  .plan-ico {
    width: 46px; height: 46px; flex: none;
    display: grid; place-items: center;
    border-radius: 13px;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .plan-ico :global(svg) { width: 24px; height: 24px; }
  .plan-head h3 { margin: 0; font-size: 1.12rem; }
  .plan-audience { margin: -6px 0 0; color: var(--text-muted); font-size: 0.9rem; }

  .plan-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0; padding: 14px 0; border-block: 1px solid var(--border); }
  .plan-meta dt { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); font-weight: 700; }
  .plan-meta dd { margin: 3px 0 0; font-weight: 700; color: var(--heading); font-size: 0.95rem; }

  .plan-block h4 { margin: 0 0 8px; font-family: var(--font-body); font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-strong); }
  .plan-block p { margin: 0; color: var(--text-muted); font-size: 0.92rem; }
  .plan-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .plan-list li { display: flex; gap: 9px; align-items: flex-start; font-size: 0.9rem; color: var(--text); }
  .pl-ico { flex: none; width: 16px; height: 16px; margin-top: 4px; }
  .pl-ico :global(svg) { width: 100%; height: 100%; }
  .plan-list.good .pl-ico { color: var(--green); }
  .plan-list.warn .pl-ico { color: var(--accent-strong); }
</style>
