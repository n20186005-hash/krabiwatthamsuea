---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { attraction } from '../config';

const lang = getLangFromUrl(Astro.url);
const { messages } = getI18n(Astro.url);
const bc = messages.breadcrumb;

/* 地理归属层级：景点全称 → 城市 → 省/州 → 国家 */
const chain = [
  { label: attraction.fullName, sub: attraction.fullNameThai, href: `/${lang}/#top` },
  { label: attraction.city, sub: '', href: `/${lang}/#overview` },
  { label: attraction.stateProvince, sub: '', href: `/${lang}/#overview` },
  { label: attraction.country, sub: '', href: `/${lang}/#visit` },
];
---

<nav class="geo-breadcrumb" aria-label={bc.current}>
  <div class="container">
    <ol>
      {chain.map((it, i) => (
        <li>
          <a href={it.href}>
            <span class="crumb-label">{it.label}</span>
            {it.sub && <span class="crumb-sub">{it.sub}</span>}
          </a>
          {i < chain.length - 1 && <span class="crumb-sep" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .geo-breadcrumb {
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .geo-breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 10px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .geo-breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .geo-breadcrumb a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 600;
    color: var(--text);
  }
  .geo-breadcrumb a:hover .crumb-label { color: var(--accent-strong); }
  .crumb-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 400;
  }
  .crumb-sep { color: var(--border-strong); }
</style>
